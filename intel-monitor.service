[Unit]
Description=Threat Intel Monitor (101 feeds -> Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/intel-monitor
ExecStart=/usr/bin/python3 /opt/intel-monitor/monitor.py --loop 180
Restart=always
RestartSec=10
User=ubuntu
Environment=TZ=Asia/Kolkata

# Logging
StandardOutput=append:/opt/intel-monitor/logs/service.log
StandardError=append:/opt/intel-monitor/logs/service.log

[Install]
WantedBy=multi-user.target
